<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Upload CSV — SAMPARK</title>
    <!-- All head content (CSS, fonts, etc.) is the same as your other pages -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              background: "#f8f5f2",
              foreground: "#1f1c18",
              card: "#ffffff",
              "card-foreground": "#1f1c18",
              primary: "#a16207",
              "primary-foreground": "#ffffff",
              secondary: "#b99553",
              border: "rgba(0, 0, 0, 0.08)",
            },
            fontFamily: {
              sans: ["Inter", "sans-serif"],
              serif: ["Playfair Display", "serif"],
            },
            boxShadow: { soft: "0 4px 12px rgba(0, 0, 0, 0.05)" },
          },
        },
      };
    </script>
  </head>
  <body class="bg-background text-foreground font-sans">
  <%- include('../partials/_messages') %>
    <div class="flex h-screen">
      <!-- Sidebar -->
        <%- include('../partials/_collegeAside') %>
        

      <!-- Main Content -->
      <main class="flex-1 overflow-y-auto p-4 md:p-8">
        <div class="max-w-7xl mx-auto">
          <div class="mb-6">
            <a
              href="/college/alumni"
              class="flex items-center gap-2 text-sm text-gray-500 hover:text-primary font-semibold"
            >
              <i data-lucide="arrow-left" class="w-4 h-4"></i>
              Back to Alumni List
            </a>
            <h2
              class="text-2xl md:text-3xl font-serif font-bold text-foreground mt-2"
            >
              Upload CSV File
            </h2>
            <p class="text-gray-500">
              Upload a CSV file with alumni data to add multiple records at
              once.
            </p>
          </div>

          <!-- This wrapper centers the form on the page -->
          <div class="max-w-3xl mx-auto">
            <form
              action="/college/upload/csv"
              method="POST"
              enctype="multipart/form-data"
              class="bg-card p-6 md:p-8 rounded-xl shadow-soft"
            >
              <label
                for="file-upload"
                class="flex flex-col items-center justify-center w-full h-64 border-2 border-border border-dashed rounded-lg cursor-pointer bg-background/50 hover:bg-background"
              >
                <div
                  class="flex flex-col items-center justify-center pt-5 pb-6 text-center"
                >
                  <i
                    data-lucide="upload-cloud"
                    class="w-10 h-10 md:w-12 md:h-12 text-gray-400 mb-3"
                  ></i>
                  <p class="mb-2 text-sm text-gray-500">
                    <span class="font-semibold">Click to upload</span> or drag
                    and drop
                  </p>
                  <p class="text-xs text-gray-500">CSV file (MAX. 5MB)</p>
                  <p
                    id="file-name"
                    class="text-sm text-primary font-semibold mt-2 px-4 truncate"
                  ></p>
                </div>
                <input
                  id="file-upload"
                  name="alumni-csv"
                  type="file"
                  class="hidden"
                  accept=".csv"
                />
              </label>
              <div class="mt-6 flex justify-end">
                <button
                  type="submit"
                  class="w-full md:w-auto px-8 py-2.5 rounded-md bg-primary text-primary-foreground font-semibold hover:bg-primary/90 transition-colors shadow-soft"
                >
                  Upload and Process File
                </button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
    <script>
      lucide.createIcons();
      document.getElementById("file-upload").onchange = function () {
        if (this.files.length > 0) {
          document.getElementById("file-name").textContent = this.files[0].name;
        }
      };
    </script>
  </body>
</html>
